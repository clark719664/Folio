[Unit]
Description=Folio host pressure governor
After=folio-converter.service
Requires=folio-converter.service

[Service]
ExecStart=/usr/bin/python3 /opt/folio-converter/pressure-governor.py
Restart=on-failure
RestartSec=5
User=root
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
MemoryMax=64M
CPUQuota=5%
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/proc

[Install]
WantedBy=multi-user.target
